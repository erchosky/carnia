generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// La URL de conexión se configura en prisma.config.ts (CLI) y en src/index.ts (runtime).
datasource db {
  provider = "postgresql"
}

// ─────────────────── USERS ───────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?

  xp    Int @default(0)
  level Int @default(1)

  rankedStats   RankedStats?
  refreshTokens RefreshToken[]
  matchesAsP1   Match[]            @relation("MatchP1")
  matchesAsP2   Match[]            @relation("MatchP2")
  participants  MatchParticipant[]
  answers       MatchAnswer[]
  friendsOf     Friendship[]       @relation("FriendOwner")
  friendsAs     Friendship[]       @relation("FriendTarget")
  dailyEntries  DailyEntry[]
  achievements  UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([xp])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  family    String
  revokedAt DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

model RankedStats {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  elo        Int      @default(1000)
  peakElo    Int      @default(1000)
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  winStreak  Int      @default(0)
  bestStreak Int      @default(0)
  seasonId   String?
  season     Season?  @relation(fields: [seasonId], references: [id])
  updatedAt  DateTime @updatedAt

  @@index([elo])
  @@index([seasonId, elo])
}

model Friendship {
  id        String           @id @default(cuid())
  ownerId   String
  targetId  String
  status    FriendshipStatus
  owner     User             @relation("FriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target    User             @relation("FriendTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([ownerId, targetId])
  @@index([targetId, status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

// ─────────────────── QUESTIONS ───────────────────

model Question {
  id          String           @id @default(cuid())
  prompt      String
  explanation String
  imageUrl    String?
  category    QuestionCategory
  difficulty  Int              @default(1)
  isTrap      Boolean          @default(false)
  source      String?
  tags        String[]
  active      Boolean          @default(true)

  options QuestionOption[]
  answers MatchAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, difficulty, active])
  @@index([isTrap])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

enum QuestionCategory {
  SIGNALS
  PRIORITY
  OVERTAKING
  ROUNDABOUTS
  SPEED
  ALCOHOL_DRUGS
  DOCUMENTATION
  ROAD_SAFETY
  PARKING
  INTERSECTIONS
  EFFICIENT_DRIVING
  MECHANICS
  FIRST_AID
  LIGHTING
  SAFETY_SYSTEMS
  ROAD_USE
  CARGO
  RISK_FACTORS
  VULNERABLE_USERS
  ADVERSE_CONDITIONS
}

// ─────────────────── ROOMS & MATCHES ───────────────────

model Room {
  id         String     @id @default(cuid())
  code       String     @unique
  hostId     String
  mode       MatchMode
  status     RoomStatus @default(LOBBY)
  maxPlayers Int        @default(2)
  match      Match?
  createdAt  DateTime   @default(now())
  closedAt   DateTime?

  @@index([code])
  @@index([status])
}

enum RoomStatus {
  LOBBY
  STARTING
  IN_MATCH
  FINISHED
  ABANDONED
}

enum MatchMode {
  PVP_1V1
  SOLO
  RANKED
  CUSTOM
}

model Match {
  id            String      @id @default(cuid())
  roomId        String?     @unique
  room          Room?       @relation(fields: [roomId], references: [id])
  mode          MatchMode
  status        MatchStatus @default(IN_PROGRESS)
  player1Id     String
  player2Id     String?
  player1       User        @relation("MatchP1", fields: [player1Id], references: [id])
  player2       User?       @relation("MatchP2", fields: [player2Id], references: [id])
  winnerId      String?
  questionCount Int         @default(10)
  durationMs    Int?
  seasonId      String?
  season        Season?     @relation(fields: [seasonId], references: [id])

  participants MatchParticipant[]
  answers      MatchAnswer[]

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([player1Id, startedAt])
  @@index([player2Id, startedAt])
  @@index([seasonId])
  @@index([mode, status])
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
  VOIDED
}

model MatchParticipant {
  id           String @id @default(cuid())
  matchId      String
  userId       String
  score        Int    @default(0)
  correctCount Int    @default(0)
  avgAnswerMs  Int    @default(0)
  xpEarned     Int    @default(0)
  eloDelta     Int    @default(0)
  match        Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user         User   @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([userId])
}

model MatchAnswer {
  id          String   @id @default(cuid())
  matchId     String
  userId      String
  questionId  String
  optionId    String?
  isCorrect   Boolean
  answerMs    Int
  scoreGained Int
  roundIndex  Int

  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([matchId, userId, roundIndex])
  @@index([userId, isCorrect])
  @@index([questionId])
}

// ─────────────────── DAILY CHALLENGE ───────────────────

model DailyChallenge {
  id          String       @id @default(cuid())
  date        String       @unique // "2026-05-16"
  questionIds String[] // ordered list of question IDs for that day
  createdAt   DateTime     @default(now())
  entries     DailyEntry[]
}

model DailyEntry {
  id           String         @id @default(cuid())
  userId       String
  date         String
  score        Int
  correctCount Int
  completedAt  DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id])
  challenge    DailyChallenge @relation(fields: [date], references: [date])

  @@unique([userId, date])
  @@index([date, score(sort: Desc)])
}

// ─────────────────── ACHIEVEMENTS ───────────────────

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

// ─────────────────── SEASONS ───────────────────

model Season {
  id          String        @id @default(cuid())
  name        String
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean       @default(false)
  matches     Match[]
  rankedStats RankedStats[]

  @@index([active])
}
