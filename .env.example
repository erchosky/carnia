# Referencia de todas las variables. Cada servicio lee su propio archivo:
#   packages/db/.env   → DATABASE_URL, DIRECT_URL
#   apps/api/.env      → API
#   apps/web/.env.local → NEXT_PUBLIC_*

# ─── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://carnia:carnia@localhost:5433/carnia?schema=public"
DIRECT_URL="postgresql://carnia:carnia@localhost:5433/carnia?schema=public"

# ─── Redis ────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ──────────────────────────────────────────────
API_PORT=3001
WEB_URL="http://localhost:3000"
# Genera uno real con: openssl rand -hex 64
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-please"
# Solo detrás de un proxy (Railway, Fly, Nginx…): nº de saltos de confianza
# TRUST_PROXY=1

# ─── Web ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
